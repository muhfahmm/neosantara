# Copy to apps/.env.local and fill in. .env.local is git-ignored; never commit real values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_NAME=db_presiden_simulator
# Required. No default is provided in code.
DB_PASSWORD=

# Firebase Web app configuration. These public client values are not server secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_ANDROID_API_KEY=
NEXT_PUBLIC_FIREBASE_ANDROID_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PLAY_GAMES_WEB_CLIENT_ID=
NEXT_PUBLIC_PLAY_GAMES_PROJECT_ID=
# Firebase service account JSON for server-side ID token verification.
# Keep this secret in .env.local or your deployment secret manager; never use NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=

